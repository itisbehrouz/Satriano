# =============================================================================
# SATRIANO ATELIER — ENVIRONMENT VARIABLE REFERENCE
# =============================================================================
# Copy this file to .env.local and fill in your real values.
# .env.local is gitignored and is NEVER uploaded to Vercel build servers.
# Production values are set via: Vercel Dashboard > Project Settings > Environment Variables
# =============================================================================

# ---- Database (Supabase / PostgreSQL) ----------------------------------------
# Transaction-mode pooler (port 6543, pgbouncer=true) — used by app at runtime
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"

# Direct / non-pooled connection (port 5432) — used by Prisma migrations only
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# ---- Admin Authentication ----------------------------------------------------
ADMIN_ACCESS_KEY="replace-with-64-char-hex-secret"
ADMIN_JWT_SECRET="replace-with-64-char-hex-secret"
