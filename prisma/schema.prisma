// Satriano Atelier — Faz 1 MVP data model.

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  DRAFT
  PENDING_REVIEW
  PROFORMA_SENT
  APPROVED
  PAID
  IN_PRODUCTION
  SHIPPED
  CANCELLED
}

enum LogoPlacement {
  LEFT_CHEST
  RIGHT_SLEEVE
}

enum PaymentMethod {
  VIRTUAL_POS
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

model Company {
  id        String   @id @default(cuid())
  name      String
  taxId     String?
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]
}

model Category {
  id            String        @id @default(uuid())
  name          String
  slug          String        @unique
  description   String?
  sortOrder     Int           @default(0)
  active        Boolean       @default(true)
  imageUrl      String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  subcategories Subcategory[]
}

model Subcategory {
  id            String                  @id @default(uuid())
  categoryId    String
  category      Category                @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name          String
  slug          String                  @unique
  description   String?
  imageUrl      String?
  leadTimeDays  Int?                    @default(14)
  moq           Int?                    @default(50)
  active        Boolean                 @default(true)
  sortOrder     Int                     @default(0)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  sizeSystems   SubcategorySizeSystem[]
  products      Product[]
}

model Product {
  id                     String       @id @default(uuid())
  subcategoryId          String
  subcategory            Subcategory  @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)
  name                   String
  slug                   String       @unique
  description            String?
  imageUrl               String?
  leadTimeDays           Int?         @default(14)
  moq                    Int?         @default(50)
  moqPerFabric           Int          @default(50)
  moqCombinedMultiFabric Int?
  active                 Boolean      @default(true)
  sortOrder              Int          @default(0)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  fabrics                Fabric[]
  fits                   ProductFit[]
  orderLines             OrderLine[]
}

model Fit {
  id          String       @id @default(uuid())
  name        String       @unique // "Slim Fit", "Regular Fit", "Relaxed Fit", "Tailored Fit", "Skinny Fit", "Tapered Fit", "Modern Fit", "Oversized"
  code        String       @unique // "SLIM", "REGULAR", "RELAXED", "TAILORED", "SKINNY", "TAPERED", "MODERN", "OVERSIZED"
  description String?
  sortOrder   Int          @default(0)
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  products    ProductFit[]
  orderLines  OrderLine[]
}

model ProductFit {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  fitId     String
  fit       Fit     @relation(fields: [fitId], references: [id], onDelete: Cascade)

  @@unique([productId, fitId])
}

model SizeSystem {
  id            String                  @id @default(uuid())
  name          String                  // "Alpha", "Waist", "Chest", "Shoe", "OneSize"
  region        String                  // "EU" or "US"
  options       SizeOption[]
  subcategories SubcategorySizeSystem[]
  orderLines    OrderLine[]
}

model SizeOption {
  id           String     @id @default(uuid())
  sizeSystemId String
  sizeSystem   SizeSystem @relation(fields: [sizeSystemId], references: [id], onDelete: Cascade)
  label        String     // "M", "44", "42", "XS", "One Size"
  sortOrder    Int        @default(0)
}

model SubcategorySizeSystem {
  id            String      @id @default(uuid())
  subcategoryId String
  subcategory   Subcategory @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)
  sizeSystemId  String
  sizeSystem    SizeSystem  @relation(fields: [sizeSystemId], references: [id], onDelete: Cascade)

  @@unique([subcategoryId, sizeSystemId])
}

model Fabric {
  id            String   @id @default(cuid())
  productId     String?
  product       Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name          String
  description   String?
  imageUrl      String?
  colorway      String?
  priceMinCents Int
  priceMaxCents Int
  setupFeeCents Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  orderLines OrderLine[]

  @@unique([name, productId])
}

model Order {
  id                       String      @id @default(cuid())
  companyId                String
  status                   OrderStatus @default(PENDING_REVIEW)
  setupFeeCents            Int         @default(0)
  totalCents               Int         @default(0)
  customerTargetPriceCents Int?
  finalPriceCents          Int?
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt

  company    Company     @relation(fields: [companyId], references: [id])
  lines      OrderLine[]
  logoAssets LogoAsset[]
  proforma   Proforma?
  payment    Payment?
}

model OrderLine {
  id             String      @id @default(cuid())
  orderId        String
  fabricId       String
  productId      String?
  fitId          String?
  selectedFit    String?
  sizeSystemId   String?
  selectedSize   String?
  size           String
  quantity       Int
  unitPriceCents Int

  order      Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fabric     Fabric      @relation(fields: [fabricId], references: [id])
  product    Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  fit        Fit?        @relation(fields: [fitId], references: [id], onDelete: SetNull)
  sizeSystem SizeSystem? @relation(fields: [sizeSystemId], references: [id], onDelete: SetNull)
}

model LogoAsset {
  id         String        @id @default(cuid())
  orderId    String
  storageUrl String
  placement  LogoPlacement
  uploadedAt DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Proforma {
  id         String    @id @default(cuid())
  orderId    String    @unique
  refNo      String    @unique
  pdfUrl     String?
  sentAt     DateTime?
  validUntil DateTime?
  createdAt  DateTime  @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Payment {
  id        String        @id @default(cuid())
  orderId   String        @unique
  method    PaymentMethod @default(VIRTUAL_POS)
  status    PaymentStatus @default(PENDING)
  posRef    String?
  createdAt DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model B2bApplication {
  id           String            @id @default(cuid())
  companyName  String
  website      String?
  industry     String?
  annualVolume String?
  fullName     String
  jobTitle     String?
  corpEmail    String
  phone        String?
  needs        Json?
  status       ApplicationStatus @default(SUBMITTED)
  createdAt    DateTime          @default(now())
  reviewedAt   DateTime?
  reviewedBy   String?
}

model MagicLinkToken {
  id        String    @id @default(uuid())
  email     String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}
