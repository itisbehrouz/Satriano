// Satriano Atelier — Faz 1 MVP data model.

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  DRAFT
  PENDING_REVIEW
  PROFORMA_SENT
  APPROVED
  PAID
  IN_PRODUCTION
  SHIPPED
  CANCELLED
}

enum LogoPlacement {
  LEFT_CHEST
  RIGHT_SLEEVE
}

enum PaymentMethod {
  VIRTUAL_POS
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

model Company {
  id        String   @id @default(cuid())
  name      String
  taxId     String?
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users  User[]
  orders Order[]
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  companyId String
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id])
}

model Fabric {
  id             String   @id @default(cuid())
  name           String   @unique
  description    String?
  imageUrl       String?
  colorway       String?
  priceMinCents  Int
  priceMaxCents  Int
  setupFeeCents  Int      @default(0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  orderLines OrderLine[]
}

model Order {
  id                       String      @id @default(cuid())
  companyId                String
  status                   OrderStatus @default(PENDING_REVIEW)
  setupFeeCents            Int         @default(0)
  totalCents               Int         @default(0)
  customerTargetPriceCents Int?
  finalPriceCents          Int?
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt

  company    Company     @relation(fields: [companyId], references: [id])
  lines      OrderLine[]
  logoAssets LogoAsset[]
  proforma   Proforma?
  payment    Payment?
}

model OrderLine {
  id             String @id @default(cuid())
  orderId        String
  fabricId       String
  size           String
  quantity       Int
  unitPriceCents Int

  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fabric Fabric @relation(fields: [fabricId], references: [id])
}

model LogoAsset {
  id         String        @id @default(cuid())
  orderId    String
  storageUrl String
  placement  LogoPlacement
  uploadedAt DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Proforma {
  id         String    @id @default(cuid())
  orderId    String    @unique
  refNo      String    @unique
  pdfUrl     String?
  sentAt     DateTime?
  validUntil DateTime?
  createdAt  DateTime  @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Payment {
  id        String        @id @default(cuid())
  orderId   String        @unique
  method    PaymentMethod @default(VIRTUAL_POS)
  status    PaymentStatus @default(PENDING)
  posRef    String?
  createdAt DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model B2bApplication {
  id           String            @id @default(cuid())
  companyName  String
  website      String?
  industry     String?
  annualVolume String?
  fullName     String
  jobTitle     String?
  corpEmail    String
  phone        String?
  needs        Json?
  status       ApplicationStatus @default(SUBMITTED)
  createdAt    DateTime          @default(now())
  reviewedAt   DateTime?
  reviewedBy   String?
}
