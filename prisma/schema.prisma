// Satriano Atelier — Faz 1 MVP data model.

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  DRAFT
  PENDING_REVIEW
  PROFORMA_SENT
  APPROVED
  PAID
  IN_PRODUCTION
  SHIPPED
  CANCELLED
}

enum LogoPlacement {
  LEFT_CHEST
  RIGHT_SLEEVE
}

enum PaymentMethod {
  VIRTUAL_POS
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

model Company {
  id        String   @id @default(cuid())
  name      String
  taxId     String?
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]
  supportTickets SupportTicket[]
}

model Category {
  id            String        @id @default(uuid())
  name          String
  slug          String        @unique
  description   String?
  sortOrder     Int           @default(0)
  active        Boolean       @default(true)
  imageUrl      String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  subcategories Subcategory[]
  wholesaleProducts WholesaleProduct[]
}

model Subcategory {
  id            String                  @id @default(uuid())
  categoryId    String
  category      Category                @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name          String
  slug          String                  @unique
  description   String?
  imageUrl      String?
  leadTimeDays  Int?                    @default(14)
  moq           Int?                    @default(50)
  active        Boolean                 @default(true)
  sortOrder     Int                     @default(0)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  sizeSystems   SubcategorySizeSystem[]
  products      Product[]
}

model Product {
  id                     String       @id @default(uuid())
  subcategoryId          String
  subcategory            Subcategory  @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)
  name                   String
  slug                   String       @unique
  description            String?
  imageUrl               String?
  leadTimeDays           Int?         @default(14)
  moq                    Int?         @default(50)
  moqPerFabric           Int          @default(50)
  moqCombinedMultiFabric Int?
  active                 Boolean      @default(true)
  sortOrder              Int          @default(0)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  fabrics                Fabric[]
  fits                   ProductFit[]
  orderLines             OrderLine[]
  materialComponents     ProductMaterialComponent[]
}

enum MaterialComponent {
  MAIN_FABRIC
  LINING
  TRIM
  COLLAR
  CUFF
  SOLE
  HEEL
  UPPER
  BACKING
  FILL
  INTERFACING
  BINDING
  LABEL
  OTHER
}

model Fit {
  id          String       @id @default(uuid())
  name        String       @unique // "Slim Fit", "Regular Fit", "Relaxed Fit", "Tailored Fit", "Skinny Fit", "Tapered Fit", "Modern Fit", "Oversized"
  code        String       @unique // "SLIM", "REGULAR", "RELAXED", "TAILORED", "SKINNY", "TAPERED", "MODERN", "OVERSIZED"
  description String?
  sortOrder   Int          @default(0)
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  products    ProductFit[]
  orderLines  OrderLine[]
}

model ProductFit {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  fitId     String
  fit       Fit     @relation(fields: [fitId], references: [id], onDelete: Cascade)

  @@unique([productId, fitId])
}

model SizeSystem {
  id            String                  @id @default(uuid())
  name          String                  // "Alpha", "Waist", "Chest", "Shoe", "OneSize"
  region        String                  // "EU" or "US"
  options       SizeOption[]
  subcategories SubcategorySizeSystem[]
  orderLines    OrderLine[]
}

model SizeOption {
  id           String     @id @default(uuid())
  sizeSystemId String
  sizeSystem   SizeSystem @relation(fields: [sizeSystemId], references: [id], onDelete: Cascade)
  label        String     // "M", "44", "42", "XS", "One Size"
  sortOrder    Int        @default(0)
}

model SubcategorySizeSystem {
  id            String      @id @default(uuid())
  subcategoryId String
  subcategory   Subcategory @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)
  sizeSystemId  String
  sizeSystem    SizeSystem  @relation(fields: [sizeSystemId], references: [id], onDelete: Cascade)

  @@unique([subcategoryId, sizeSystemId])
}

model Fabric {
  id            String   @id @default(cuid())
  productId     String?
  product       Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name          String
  description   String?
  imageUrl      String?
  /// @deprecated Legacy single colourway field. Maintained for production row compatibility. Use FabricColor relation instead.
  colorway      String?
  priceMinCents Int
  priceMaxCents Int
  /// @deprecated Setup fee removed from business model. Maintained for legacy row compatibility only.
  setupFeeCents Int      @default(0)
  moqPerColor   Int      @default(20)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  colors            FabricColor[]
  orderLines        OrderLine[]
  lineItemMaterials LineItemMaterial[] @relation("LineItemMaterials")

  @@unique([name, productId])
}

enum ColorSource {
  PLACEHOLDER
  SUPPLIER_VERIFIED
  MANUAL
  MANUAL_OVERRIDE
}

model FabricColor {
  id        String      @id @default(cuid())
  fabricId  String
  fabric    Fabric      @relation(fields: [fabricId], references: [id], onDelete: Cascade)
  name      String
  hex       String?
  source    ColorSource @default(PLACEHOLDER)
  active    Boolean     @default(true)
  sortOrder Int         @default(0)
  createdAt DateTime    @default(now())

  orderLines        OrderLine[]
  lineItemMaterials LineItemMaterial[]

  @@unique([fabricId, name])
}

enum OrderType {
  M2O
  WHOLESALE
  MADE_TO_ORDER
}

model Order {
  id                       String      @id @default(cuid())
  companyId                String
  status                   OrderStatus @default(PENDING_REVIEW)
  /// @deprecated Setup fee removed from business model. Maintained for legacy row compatibility only.
  setupFeeCents            Int         @default(0)
  totalCents               Int         @default(0)
  customerTargetPriceCents Int?
  finalPriceCents          Int?
  orderType                OrderType?  @default(M2O)
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt

  company    Company     @relation(fields: [companyId], references: [id])
  lines      OrderLine[]
  logoAssets LogoAsset[]
  proforma   Proforma?
  payment    Payment?
  productionMilestones ProductionMilestone[]
}

model OrderLine {
  id             String       @id @default(cuid())
  orderId        String
  fabricId       String?
  colorId        String?
  selectedColor  String?
  productId      String?
  fitId          String?
  selectedFit    String?
  sizeSystemId   String?
  selectedSize   String?
  size           String
  quantity       Int
  unitPriceCents Int

  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fabric     Fabric?      @relation(fields: [fabricId], references: [id])
  color      FabricColor? @relation(fields: [colorId], references: [id], onDelete: SetNull)
  product    Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  fit        Fit?         @relation(fields: [fitId], references: [id], onDelete: SetNull)
  sizeSystem SizeSystem?  @relation(fields: [sizeSystemId], references: [id], onDelete: SetNull)

  materials LineItemMaterial[]
}

/// Line-item material assignments (supports multi-material specs)
model LineItemMaterial {
  id          String   @id @default(cuid())
  orderLineId String
  orderLine   OrderLine @relation(fields: [orderLineId], references: [id], onDelete: Cascade)

  materialId  String
  material    Fabric    @relation("LineItemMaterials", fields: [materialId], references: [id])

  colorId     String?
  color       FabricColor? @relation(fields: [colorId], references: [id])

  component   MaterialComponent @default(MAIN_FABRIC)
  composition String? // e.g., "80% Wool / 20% Cashmere" or "100% Genuine Leather"
  ratio       Float? // e.g., 0.80 for 80% of line item quantity

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([orderLineId, component])
  @@index([orderLineId])
  @@index([materialId])
}

/// Product material compatibility matrix
model ProductMaterialComponent {
  id                 String            @id @default(cuid())
  productId          String
  product            Product           @relation(fields: [productId], references: [id], onDelete: Cascade)

  component          MaterialComponent
  isRequired         Boolean           @default(false)
  allowedMaterialIds String[]          // FK array: ["fabric_id_1", "fabric_id_2"]

  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@unique([productId, component])
  @@index([productId])
}

model LogoAsset {
  id         String        @id @default(cuid())
  orderId    String
  storageUrl String
  placement  LogoPlacement
  uploadedAt DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Proforma {
  id         String    @id @default(cuid())
  orderId    String    @unique
  refNo      String    @unique
  pdfUrl     String?
  sentAt     DateTime?
  validUntil DateTime?
  createdAt  DateTime  @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Payment {
  id        String        @id @default(cuid())
  orderId   String        @unique
  method    PaymentMethod @default(VIRTUAL_POS)
  status    PaymentStatus @default(PENDING)
  posRef    String?
  createdAt DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model B2bApplication {
  id                      String                   @id @default(cuid())
  companyName             String
  website                 String?
  industry                String?
  annualVolume            String?
  fullName                String
  jobTitle                String?
  corpEmail               String
  phone                   String?
  needs                   Json?
  status                  ApplicationStatus        @default(SUBMITTED)
  emailVerifiedAt         DateTime?
  createdAt               DateTime                 @default(now())
  reviewedAt              DateTime?
  reviewedBy              String?
  emailVerificationTokens EmailVerificationToken[]
}

model EmailVerificationToken {
  id            String         @id @default(uuid())
  applicationId String
  application   B2bApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  token         String         @unique
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime       @default(now())
}

model MagicLinkToken {
  id        String    @id @default(uuid())
  email     String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
  PENDING_VERIFICATION
}

enum WholesaleProductStatus {
  ACTIVE
  INACTIVE
}

model Supplier {
  id            String         @id @default(cuid())
  firmName      String
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  website       String?
  notes         String?
  country       String?
  leadTimeDays  Int?           @default(14)
  active        Boolean        @default(true)
  status        SupplierStatus @default(PENDING_VERIFICATION)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  wholesaleProducts WholesaleProduct[]
  slas              SupplierSLA[]
}

model WholesaleProduct {
  id             String                 @id @default(cuid())
  supplierId     String
  supplier       Supplier               @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  categoryId     String
  category       Category               @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name           String
  sku            String                 @unique
  description    String?
  gender         String? // "Men", "Women", "Unisex", "Boys", "Girls"
  ageGroup       String? // "Baby", "Kids", "Teen", "Adult"
  costPriceCents Int
  markupPercent  Float                  @default(35.0)
  sellPriceCents Int
  status         WholesaleProductStatus @default(ACTIVE)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  images WholesaleProductImage[]
  stock  WholesaleStock[]
  forecasts InventoryForecast[]
  policy    InventoryPolicy?
  audits    InventoryAudit[]
  lowStockAlerts LowStockAlert[]

  @@index([gender])
  @@index([ageGroup])
}

model WholesaleProductImage {
  id                 String           @id @default(cuid())
  wholesaleProductId String
  wholesaleProduct   WholesaleProduct @relation(fields: [wholesaleProductId], references: [id], onDelete: Cascade)
  url                String
  sortOrder          Int              @default(0)
}

model WholesaleStock {
  id                 String           @id @default(cuid())
  wholesaleProductId String
  wholesaleProduct   WholesaleProduct @relation(fields: [wholesaleProductId], references: [id], onDelete: Cascade)
  size               String
  quantity           Int              @default(0)
  lowStockThreshold  Int              @default(3)

  @@unique([wholesaleProductId, size])
}

enum AdminRole {
  SUPER_ADMIN
  CATALOG_MANAGER
  ORDER_OPERATOR
  SUPPLIER_MANAGER
}

model ProductionMilestone {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  stage     String
  status    String
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
}

model StockReservation {
  id        String   @id @default(cuid())
  skuId     String
  quantity  Int
  orderId   String
  expiresAt DateTime
  status    String   @default("RESERVED")
  createdAt DateTime @default(now())

  @@index([skuId])
  @@index([orderId])
}

model Notification {
  id             String   @id @default(cuid())
  recipientEmail String
  title          String
  message        String
  read           Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([recipientEmail])
}

model AuditLog {
  id           String   @id @default(cuid())
  adminEmail   String
  action       String
  targetEntity String
  targetId     String?
  details      String?
  createdAt    DateTime @default(now())

  @@index([adminEmail])
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model SupportTicket {
  id           String                @id @default(cuid())
  ticketNo     String                @unique
  companyId    String?
  company      Company?              @relation(fields: [companyId], references: [id], onDelete: SetNull)
  companyEmail String
  subject      String
  message      String
  status       SupportTicketStatus   @default(OPEN)
  priority     SupportTicketPriority @default(MEDIUM)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  messages TicketMessage[]

  @@index([companyEmail])
  @@index([status])
}

model TicketMessage {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender    String
  message   String
  createdAt DateTime      @default(now())

  @@index([ticketId])
}

model InventoryForecast {
  id                     String           @id @default(cuid())
  productId              String
  product                WholesaleProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  size                   String
  forecastedDemand30Days Int
  forecastedDemand90Days Int
  historicalMovementRate Float
  lastUpdated            DateTime         @default(now())

  @@unique([productId, size])
}

model InventoryPolicy {
  id                  String           @id @default(cuid())
  productId           String           @unique
  product             WholesaleProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  reorderPoint        Int
  reorderQuantity     Int
  safetyStock         Int
  leadTimeDays        Int
  autoReorderEnabled  Boolean          @default(false)
  preferredSupplierId String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
}

model SupplierSLA {
  id                      String   @id @default(cuid())
  supplierId              String
  supplier                Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  standardLeadTimeDays    Int
  expeditedLeadTimeDays   Int?
  expeditedCostMultiplier Float?
  onTimeDeliveryTarget    Float
  minOrderValue           Int
  maxOrderValue           Int?
  qualityAgreement        String?
  paymentTerms            String
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([supplierId])
}

model InventoryAudit {
  id               String            @id @default(cuid())
  productId        String
  product          WholesaleProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
  size             String
  action           String
  quantityChanged  Int
  previousQuantity Int
  newQuantity      Int
  reason           String?
  reference        String?
  performedBy      String
  notes            String?
  createdAt        DateTime          @default(now())

  @@index([productId])
}

model LowStockAlert {
  id               String            @id @default(cuid())
  productId        String
  product          WholesaleProduct? @relation(fields: [productId], references: [id], onDelete: Cascade)
  size             String
  currentQuantity  Int
  threshold        Int
  severity         String            @default("WARNING")
  acknowledged     Boolean           @default(false)
  createdAt        DateTime          @default(now())

  @@index([productId])
  @@index([acknowledged])
}

model WebhookLog {
  id            String   @id @default(cuid())
  stripeEventId String   @unique
  eventType     String
  processed     Boolean  @default(false)
  errorMessage  String?
  rawPayload    String?
  createdAt     DateTime @default(now())

  @@index([eventType])
}

model ExternalWebhook {
  id        String   @id @default(cuid())
  url       String
  event     String
  secret    String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([event])
}

model IntegrationConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

